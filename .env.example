# Copy to .env (git-ignored) and adjust. Values below match compose.yaml.
# Operator connection (migrations, init, operator CLI). Locally the owner.
DATABASE_URL=postgres://teammemory:teammemory-dev@127.0.0.1:55432/teammemory?sslmode=disable
# Runtime roles, created with `make dev-roles` (throwaway local passwords).
TEAM_MEMORY_APP_DATABASE_URL=postgres://tm_app:tm-app-dev@127.0.0.1:55432/teammemory?sslmode=disable
TEAM_MEMORY_WORKER_DATABASE_URL=postgres://tm_worker:tm-worker-dev@127.0.0.1:55432/teammemory?sslmode=disable
TEST_DATABASE_URL=postgres://teammemory:teammemory-dev@127.0.0.1:55432/postgres?sslmode=disable
TEAM_MEMORY_LISTEN=127.0.0.1:8080
TEAM_MEMORY_PUBLIC_URL=http://localhost:8080
# Optional: hybrid search. Leave unset for full-text only.
# TEAM_MEMORY_OLLAMA_URL=http://127.0.0.1:11434
# TEAM_MEMORY_EMBEDDING_MODEL=nomic-embed-text
# Optional: SSO through an upstream OIDC provider (see docs/decisions/identity-provider.md).
# For local development, run deploy/dev-idp/setup.sh and use its .local/sso.json.
# TEAM_MEMORY_SSO_CONFIG=/path/to/sso.json
# Web portal (served by `serve`). See docs/decisions/portal.md.
# TEAM_MEMORY_PORTAL=off
# TEAM_MEMORY_PORTAL_BASE_PATH=/portal
# TEAM_MEMORY_PORTAL_IDLE_TIMEOUT=30m
# TEAM_MEMORY_PORTAL_ABSOLUTE_TIMEOUT=12h
# TEAM_MEMORY_PORTAL_SOURCE_SCHEMES=jira
# auto (solo only), owner (SSO mode: owner until SSO is linked), all, off
# TEAM_MEMORY_PORTAL_TOKEN_SIGNIN=auto
# Operations listener: /metrics, /healthz, /readyz (never expose publicly).
# TEAM_MEMORY_METRICS_LISTEN=127.0.0.1:9090
# Reverse proxies whose X-Forwarded-For is trusted (CIDRs).
# TEAM_MEMORY_TRUSTED_PROXIES=
# Tracing export (standard OpenTelemetry variables).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Git mirror worker (`team-memory mirror worker`), see docs/operations/mirror.md.
# TEAM_MEMORY_MIRROR_DATABASE_URL=postgres://tm_mirror:...@127.0.0.1:55432/teammemory?sslmode=disable
# TEAM_MEMORY_MIRROR_REMOTE=file:///tmp/team-memory-mirrors/{repo}.git
